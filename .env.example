# Paths (all heavy data stays inside the repo, under ./data)
DATA_DIR=./data
TMPDIR=./data/tmp
DUCKDB_TEMP_DIR=./data/duckdb_tmp

# Geographic scope: ISO 3166-2 codes. AR-C = CABA, AR-B = Buenos Aires province.
SCOPE_PROVINCES=AR-C,AR-B

# Detail level
TOP_N_EANS=2500
DETAIL_RETENTION_DAYS=90
AGG_RETENTION_DAYS=365

# Data quality
VOLUME_TOLERANCE_PCT=30
MAX_CARRY_FORWARD_DAYS=3
MIN_COVERAGE_PCT=90

# dbt
DBT_PROFILES_DIR=./dbt

# Cuentas (obligatorias en el dashboard). Copiar desde Supabase → Settings → API.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<anon-public-key>
